# Optional: share float lookups (pillar 5). Free key at financialmodelingprep.com
FMP_API_KEY=

# --- Crypto (only if market: crypto and mode: live) ---
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSWORD=
