# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Only needed when mode: live in config.yaml. Create keys with TRADE permission
# only - never withdrawal permission.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Some exchanges (e.g. OKX, KuCoin) also need a passphrase
EXCHANGE_API_PASSWORD=
