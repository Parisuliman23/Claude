# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# --- Stocks (Alpaca) ---
# Free account at alpaca.markets. Start with the PAPER trading keys
# (Paper Trading dashboard -> API Keys). Live keys only when mode: live.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Optional: share float (pillar 5) from financialmodelingprep.com. The FREE plan only
# covers large companies; small caps fall back automatically to free SEC data
# (shares outstanding, no key needed). A paid FMP plan gives true float for small caps.
FMP_API_KEY=

# --- Crypto (only if market: crypto and mode: live) ---
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSWORD=

# --- Phone alerts + remote control (ntfy app, free) ---
# Make up a long random topic name (like a password). In the ntfy app subscribe to
# BOTH  <topic>  (alerts)  and  <topic>-cmd  (where you send: status / stop / resume / flatten / help)
NTFY_TOPIC=
